#!/usr/bin/env grease
set -eu -o pipefail
test "$#" -eq 2
var root = ARGV[0]
var output = ARGV[1]
mkdir -p "$output/compiled"
cd "$root"
cargo generate-lockfile
cargo test --workspace --locked
rustup target add wasm32-unknown-unknown
cargo build --release --locked --target wasm32-unknown-unknown -p kleinian-web
cargo tree --locked -p kleinian-web -i wasm-bindgen --depth 0 > "$output/bindgen-dependency.txt"
var bindgen_version = $(awk '$1 == "wasm-bindgen" { sub(/^v/, "", $2); print $2 }' "$output/bindgen-dependency.txt")
printf '%s\n' "$bindgen_version" | rg -x '[0-9]+[.][0-9]+[.][0-9]+'
cargo install wasm-bindgen-cli --version "$bindgen_version" --locked
wasm-bindgen target/wasm32-unknown-unknown/release/kleinian_web.wasm --out-dir "$output/compiled" --target web --no-typescript
cp -R "$output/compiled/." kleinian-web/pkg/
cp -R "$output/compiled/." .baseline/kleinian-web/pkg/
cp Cargo.lock "$output/Cargo.lock"
rustc --version > "$output/rustc-version.txt"
cargo --version > "$output/cargo-version.txt"
sha256sum "$output/compiled/kleinian_web_bg.wasm" > "$output/wasm.sha256"
